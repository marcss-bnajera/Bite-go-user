# ============================================================================
# Bite&Go User Service - Variables de entorno
# ============================================================================
# Copia este archivo a `.env` y rellena los valores reales.
# ============================================================================

# Puerto del servicio (Render asigna PORT automáticamente)
PORT=3001
NODE_ENV=development

# MongoDB (Atlas: mongodb+srv://<user>:<pass>@cluster.xxxxx.mongodb.net/BiteGoDB)
URL_MONGODB=mongodb://mongodb:27017/BiteGoDB

# JWT — DEBE ser idéntico en auth-service, Bite-go-user y Bite-go-admin
JWT_SECRET=bitego_super_secret_key_2024_largo
JWT_ISSUER=BiteGoAuthService
JWT_AUDIENCE=BiteGoServices

# Cloudinary (https://console.cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
CLOUDINARY_PROFILES_FOLDER=user/profiles

# CORS — orígenes permitidos separados por coma (vacío = permitir todos)
ALLOWED_ORIGIN=http://localhost:5173,http://localhost:5174

# URL del admin-service (Docker usa http://admin-service:3002; en Render la del servicio desplegado)
ADMIN_SERVICE_URL=http://admin-service:3002

# Secret compartido con admin-service para las rutas inter-servicio (/inventory/check, /reduce, /restore)
INTER_SERVICE_SECRET=
